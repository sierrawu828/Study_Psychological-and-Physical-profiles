TITLE: BCH analysis;
DATA: FILE IS Sample1_data.dat;
VARIABLE:
    NAME ARE ZPR Zlog_MVPA Zlog_LPA 
    gender bmi_thin bmi_over bmi_obe 
    Household Onlychild sch_985 sch_211 
    MPA Anxiety;

    USEVARIABLES = ZPR Zlog_MVPA Zlog_LPA;
    CLASSES = C(3);
    AUXILIARY = MPA(BCH) Anxiety(BCH);

ANALYSIS:
    TYPE = MIXTURE;
    ESTIMATOR = MLR;
    STARTS = 500 100;
    PROCESSORS = 4;
    OPTSEED =999;
  
OUTPUT:
    TECH11 TECH14;
    CINTERVAL;
    